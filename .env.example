# Copy this file to .env and edit it. docker-compose.yml reads these values via
# ${VAR:-default} interpolation, so anything left unset falls back to the default
# shown here. .env is gitignored; docker-compose.yml is not, so put deployment
# specifics and all secrets here rather than editing the compose file.

# Nagios Configuration
# NAGIOS_STATUS_DAT_PATH is fixed by the volume mount in docker-compose.yml.
NAGIOS_HOSTGROUPS=public-status
NAGIOS_SERVICEGROUPS=public-status-services
# Explicit host / service lists, if you prefer them to groups.
# NAGIOS_HOSTS=host1,host2
# NAGIOS_SERVICES=host1:HTTP,host2:Disk Space

# Polling Configuration
POLL_INTERVAL_SECONDS=300
STALENESS_THRESHOLD_SECONDS=600

# API Configuration
# Comma-separated list of allowed CORS origins.
API_CORS_ORIGINS=*
# Basic Auth guards write operations (comments, PIR updates, manual polls).
# API_BASIC_AUTH_USERNAME=statuspage
# API_BASIC_AUTH_PASSWORD=

# Signed nagiosgraph proxy, used by /api/graph for Slack notifications.
# GRAPH_SIGNING_SECRET is a shared HMAC secret. Keep it out of git.
# GRAPH_NAGIOSGRAPH_URL=http://nagios.int.example.com/cgi-bin
# GRAPH_SIGNING_SECRET=
# GRAPH_DEFAULT_TTL_SECONDS=604800
# GRAPH_BASIC_AUTH_USERNAME=
# GRAPH_BASIC_AUTH_PASSWORD=

# RSS Configuration
RSS_TITLE=System Status
RSS_DESCRIPTION=Public status updates
RSS_LINK=https://status.example.com
RSS_MAX_ITEMS=50
